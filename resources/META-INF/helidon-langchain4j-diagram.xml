<idea-plugin package="com.intellij.helidon">
  <extensions defaultExtensionNs="com.intellij">
    <diagram.Provider implementation="com.intellij.helidon.langchain4j.diagram.HelidonLangChain4jDiagramProvider"/>
  </extensions>

  <actions>
    <action id="Helidon.ShowLangChain4jWorkflowDiagram"
            class="com.intellij.helidon.langchain4j.diagram.HelidonLangChain4jShowDiagramAction"
            text="Helidon LangChain4j Workflow Diagram"
            description="Show the Helidon LangChain4j agentic workflow diagram">
      <add-to-group group-id="UML.EditorGroup" anchor="last"/>
      <add-to-group group-id="UML.Group" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
