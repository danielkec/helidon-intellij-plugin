<idea-plugin package="com.intellij.helidon">
  <id>com.intellij.helidon</id>
  <name>Helidon</name>
  <vendor>Helidon team</vendor>
  <category>JVM Frameworks</category>

  <description><![CDATA[
    <p>Adds support for the <a href="https://helidon.io/">Helidon</a> framework for building Java microservices with Helidon SE and MP.</p>
    <p>Features:</p>
    <ul>
      <li>Create Helidon Maven projects from the IDE.</li>
      <li>Create Java Helidon declarative HTTP services, server tests, LangChain4j components, and OCI configuration
        from Helidon file templates.</li>
      <li>Inspect Helidon services, contracts, injection points, lookups, endpoints, and LangChain4j components in the
        Helidon Services tool window.</li>
      <li>Navigate between Helidon services, injection points, and service registry lookups.</li>
      <li>Complete Helidon configuration keys in YAML and properties files, including OCI bootstrap configuration in
        <code>oci-config.yaml</code>.</li>
      <li>Open gutter navigation for Helidon declarative services.</li>
      <li>With IntelliJ IDEA Ultimate and the optional Microservices integration enabled: discover Helidon WebServer and
        RestServer endpoints in the Endpoints tool window, use URL resolver and inlay support, navigate declarative HTTP
        endpoint routes, and use extended Helidon configuration references, documentation, and inspections.</li>
    </ul>
  ]]></description>

  <dependencies>
    <plugin id="com.intellij.java"/>
    <plugin id="com.intellij.properties"/>
    <plugin id="org.jetbrains.idea.maven"/>
    <plugin id="JUnit"/>
    <module name="intellij.spellchecker"/>
    <module name="intellij.properties.backend"/>
    <module name="intellij.properties.backend.psi"/>
    <module name="intellij.json.backend"/>
    <module name="intellij.yaml.backend"/>
  </dependencies>

  <depends optional="true" config-file="helidon-microservices.xml">com.intellij.microservices.jvm</depends>
  <depends optional="true" config-file="helidon-langchain4j-diagram.xml">com.intellij.diagram</depends>

  <resource-bundle>messages.HelidonBundle</resource-bundle>

  <actions>
    <group id="Helidon.New" text="Helidon" popup="true" icon="/icons/helidon.svg">
      <action id="Helidon.New.DeclarativeHttpService"
              class="com.intellij.helidon.templates.HelidonCreateDeclarativeHttpServiceAction"
              text="Declarative HTTP Service"
              icon="/icons/helidonGutter.svg"/>
      <action id="Helidon.New.ServerTest"
              class="com.intellij.helidon.templates.HelidonCreateServerTestAction"
              text="Server Test"/>
      <action id="Helidon.New.LangChain4jService"
              class="com.intellij.helidon.templates.HelidonCreateLangChain4jServiceAction"
              text="LangChain4j Service"
              icon="/icons/aiGutter.svg"/>
      <action id="Helidon.New.LangChain4jAgent"
              class="com.intellij.helidon.templates.HelidonCreateLangChain4jAgentAction"
              text="LangChain4j Agent"
              icon="/icons/aiGutter.svg"/>
      <action id="Helidon.New.OciConfig"
              class="com.intellij.helidon.templates.HelidonCreateOciConfigAction"
              text="OCI Config"
              icon="/icons/ora.svg"/>
      <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewFromTemplate"/>
    </group>
  </actions>

  <extensionPoints>
    <extensionPoint
      name="serviceClassLineMarkerTargetProvider"
      interface="com.intellij.helidon.providers.HelidonServiceClassLineMarkerTargetProvider"
      dynamic="true"/>
    <extensionPoint
      name="servicesViewContributor"
      interface="com.intellij.helidon.services.HelidonServicesViewContributor"
      dynamic="true"/>
    <extensionPoint
      name="configFileContributor"
      interface="com.intellij.helidon.config.HelidonConfigFileContributor"
      dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Helidon Services"
                anchor="right"
                icon="/icons/helidonToolWindow.svg"
                factoryClass="com.intellij.helidon.services.HelidonServicesToolWindowFactory"/>

    <codeInsight.lineMarkerProvider language="JAVA" order="last"
                                    implementationClass="com.intellij.helidon.providers.HelidonClassAnnotator"/>

    <moduleBuilder builderClass="com.intellij.helidon.newproject.HelidonModuleBuilder"/>

    <externalProjectDataService implementation="com.intellij.helidon.newproject.HelidonExternalSystemDataService"/>

    <fileTemplateGroup implementation="com.intellij.helidon.templates.HelidonFileTemplateGroupDescriptorFactory"/>
    <internalFileTemplate name="Helidon Declarative HTTP Service"/>
    <internalFileTemplate name="Helidon Server Test"/>
    <internalFileTemplate name="Helidon LangChain4j Service"/>
    <internalFileTemplate name="Helidon LangChain4j Agent"/>
    <internalFileTemplate name="oci-config"/>

    <runConfigurationProducer implementation="com.intellij.helidon.testing.HelidonMavenTestRunConfigurationProducer"/>

    <dependencySupport coordinate="io.helidon.config:helidon-config" kind="java" displayName="Helidon"/>

    <completion.contributor language="Properties" order="last"
                            implementationClass="com.intellij.helidon.config.ce.HelidonPropertiesKeyCompletionContributor"/>
    <completion.contributor language="yaml"
                            implementationClass="com.intellij.helidon.config.ce.HelidonYamlKeyCompletionContributor"/>
    <completion.contributor language="yaml"
                            order="before javaClassName"
                            implementationClass="com.intellij.helidon.config.ce.HelidonYamlOciRegionValueCompletionContributor"/>

    <helidon.configFileContributor id="propertiesConfigFileContributor"
                                   implementation="com.intellij.helidon.config.properties.HelidonPropertiesConfigFileContributor"/>
    <helidon.configFileContributor
            order="after propertiesConfigFileContributor"
            implementation="com.intellij.helidon.config.yaml.HelidonYamlConfigFileContributor"/>

    <iconProvider implementation="com.intellij.helidon.config.ce.HelidonConfigFileIconProvider"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.idea.maven">
    <importing.afterImportConfigurator implementation="com.intellij.helidon.maven.HelidonMavenImporter"/>
  </extensions>
</idea-plugin>
